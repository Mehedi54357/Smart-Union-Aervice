generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Registration {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  serialNo            String
  birthRegistrationNo String
  applicantName       String
  dateOfBirth         String
  fatherName          String
  motherName          String
  pendingMoney        Float
  isDelivered         Boolean
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model WorkHistory {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  actionType          String
  title               String
  description         String
  serialNo            String?
  applicantName       String?
  birthRegistrationNo String?
  timestamp           DateTime @default(now())
}

model VisitorLog {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  visitorId  String
  ip         String?
  userAgent  String?
  device     String?
  browser    String?
  visitType  String?
  path       String?
  timestamp  DateTime @default(now())
}


